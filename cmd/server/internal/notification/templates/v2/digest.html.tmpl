          <span class="v2-help-slider-dot" data-pos="0" data-level="3" title="Full — explain every term"></span>
          <span class="v2-help-slider-dot" data-pos="1" data-level="2" title="Partial — security-specific & niche"></span>
          <span class="v2-help-slider-dot" data-pos="2" data-level="1" title="Minimal — only rare/advanced"></span>
          <span class="v2-help-slider-knob" id="help-slider-knob" aria-hidden="true"></span>
        </div>
        <div class="v2-help-slider-ends"><span>Full</span><span>Minimal</span></div>
        <div class="v2-learn-card-title">Learning features</div>
        <button class="v2-learn-feature" id="learn-feat-plain" type="button" role="switch" aria-checked="true" onclick="v2ToggleLearnFeature('plain')"><span class="v2-learn-feature-label">Plain words</span><span class="v2-learn-switch"><span class="v2-learn-switch-knob"></span></span></button>
        <button class="v2-learn-feature" id="learn-feat-glossary" type="button" role="switch" aria-checked="true" onclick="v2ToggleLearnFeature('glossary')"><span class="v2-learn-feature-label">Glossary</span><span class="v2-learn-switch"><span class="v2-learn-switch-knob"></span></span></button>
