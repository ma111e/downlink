  <section class="v2-head">
    {{if .DigestTitle}}<h1 class="v2-head-title">{{.DigestTitle}}</h1>{{end}}
    <div class="v2-head-controls">
      <span class="v2-filter-label">PRIORITY</span>
      <button type="button" class="v2-prio v2-prio-must" data-prio="must" onclick="v2FilterPrio('must')">MUST {{index .PriorityCounts "must"}}</button>
      <button type="button" class="v2-prio v2-prio-should" data-prio="should" onclick="v2FilterPrio('should')">SHOULD {{index .PriorityCounts "should"}}</button>
      <button type="button" class="v2-prio v2-prio-may" data-prio="may" onclick="v2FilterPrio('may')">MAY {{index .PriorityCounts "may"}}</button>
      {{if .OverviewSections}}<span class="v2-head-sep"></span>
      <button type="button" class="v2-chip" id="brief-toggle" onclick="v2ToggleBrief()">INTELLIGENCE BRIEF <span class="v2-caret">▾</span></button>{{end}}
    </div>
    {{if .Categories}}<div class="v2-head-row">
      <span class="v2-filter-label">CATEGORY</span>
      <button type="button" class="v2-cat on" data-cat="all" onclick="v2FilterCat(this.dataset.cat)">ALL <span class="v2-cat-n">{{.ArticleCount}}</span></button>
      {{range .Categories}}<button type="button" class="v2-cat" data-cat="{{.}}" onclick="v2FilterCat(this.dataset.cat)">{{.}} <span class="v2-cat-n">{{index $.CategoryCounts .}}</span></button>{{end}}
    </div>{{end}}
    {{if .Tags}}<div class="v2-tagcloud"><span class="v2-filter-label">TAGS</span>{{range .Tags}}<button type="button" class="v2-tag-pill" data-tag="{{.Name}}" onclick="v2ToggleTag(this.dataset.tag)">{{.Name}} <span class="v2-cat-n">{{.Count}}</span></button>{{end}}<button type="button" class="v2-tag-pill v2-tag-more" hidden onclick="v2ToggleMoreTags(this)"></button></div>{{end}}
    {{if .OverviewSections}}<div class="v2-brief" id="brief-panel" hidden>
      {{range $i, $s := .OverviewSections}}<div class="v2-brief-section">
        <div class="v2-brief-head"><span class="v2-brief-tag">{{$s.Tag}}</span><span class="v2-brief-title">{{$s.Title}}</span></div>
        <div class="v2-brief-body prose">{{$s.Body}}</div>
      </div>{{end}}
    </div>{{end}}
  </section>

  <div class="v2-main">

    <aside class="v2-toc" aria-label="Article index">
      {{range .TOCGroups}}<div class="v2-toc-group">
        <div class="v2-toc-grouphead">
          <span class="v2-toc-grouplabel {{tocNumClass .Label}}">{{.Label}}</span>{{with tocGroupTooltip .Label}}<span class="v2-info-tip" data-tip="{{.}}">ⓘ</span>{{end}}
          <span class="v2-toc-groupcount">{{len .Rows}} items</span>
          <span class="v2-toc-grouprule"></span>
        </div>
        {{range $i, $row := .Rows}}{{if $row.IsCluster}}{{with $row.Canonical}}<div class="v2-toc-item" data-target="{{.Id}}" data-priority="{{priorityKey .ReadTag}}" data-category="{{.Category}}" data-tags="{{if $row.CanonDetail}}{{joinTags $row.CanonDetail.Tags}}{{end}}" onclick="v2Select('{{.Id}}')">
          <div class="v2-toc-item-top">
            <span class="v2-toc-num {{tocNumClass .ReadTag}}">{{printf "%02d" (add $i 1)}}</span>
            <span class="v2-toc-title">{{.Title}}</span>
            {{if gt .ImportanceScore 0}}<span class="v2-toc-score {{tocNumClass .ReadTag}}">{{.ImportanceScore}}</span>{{end}}
          </div>
          <div class="v2-toc-meta">
            {{if .Category}}<span class="v2-toc-cat">{{.Category}}</span>{{end}}
            {{if $row.CanonDetail}}<span><span class="v2-dot" style="background:{{paletteVar $row.CanonDetail.Source}}"></span> {{$row.CanonDetail.Source}}</span>{{end}}
            {{if $row.Others}}<button type="button" class="v2-dup-toggle" onclick="event.stopPropagation();v2ToggleDup(this)">+{{len $row.Others}} DUPLICATES <span class="v2-caret">▾</span></button>{{end}}
          </div>
        </div>{{end}}{{if $row.Others}}<div class="v2-dup-list" hidden>
          {{range $row.Others}}<div class="v2-dup" data-target="{{.Id}}" onclick="v2Select('{{.Id}}')"><span class="v2-dup-fork">⑂</span><span class="v2-dup-title">{{.Title}}</span></div>{{end}}
        </div>{{end}}{{else}}{{with $row.Entry}}<div class="v2-toc-item" data-target="{{.Id}}" data-priority="{{priorityKey .ReadTag}}" data-category="{{.Category}}" data-tags="{{if $row.Detail}}{{joinTags $row.Detail.Tags}}{{end}}" onclick="v2Select('{{.Id}}')">
          <div class="v2-toc-item-top">
            <span class="v2-toc-num {{tocNumClass .ReadTag}}">{{printf "%02d" (add $i 1)}}</span>
            <span class="v2-toc-title">{{.Title}}</span>
            {{if gt .ImportanceScore 0}}<span class="v2-toc-score {{tocNumClass .ReadTag}}">{{.ImportanceScore}}</span>{{end}}
          </div>
          {{if or .Category $row.Detail}}<div class="v2-toc-meta">
            {{if .Category}}<span class="v2-toc-cat">{{.Category}}</span>{{end}}
            {{if $row.Detail}}<span><span class="v2-dot" style="background:{{paletteVar $row.Detail.Source}}"></span> {{$row.Detail.Source}}</span>{{end}}
          </div>{{end}}
        </div>{{end}}{{end}}{{end}}
      </div>{{end}}
      <div class="v2-toc-hint">j/k to move · enter to open source</div>
    </aside>

    <main class="v2-detail-pane">
      {{range .ArticleEntries}}{{template "v2Detail" .}}{{end}}
    </main>
  </div>
</div>

{{if .HasLearning}}<div id="glossary-popup" class="v2-gloss-popup" role="status" aria-live="polite" hidden>
  <button class="v2-gloss-close" onclick="v2CloseGloss()" aria-label="Close">✕</button>
  <div class="v2-gloss-head">
    <span id="glossary-popup-term" class="v2-gloss-term"></span>
    <span id="glossary-popup-type" class="v2-gloss-type" hidden></span>
  </div>
  <p id="glossary-popup-def" class="v2-gloss-def"></p>
  <p id="glossary-popup-context" class="v2-gloss-context" hidden><span class="v2-gloss-context-label">In this article</span> <span id="glossary-popup-context-text"></span></p>
</div>{{end}}

{{if .HasLearning}}{{if .GlossaryPanel}}
<button id="glossary-panel-toggle" class="glossary-panel-toggle" type="button" onclick="toggleGlossaryPanel()" aria-expanded="false" aria-controls="glossary-panel" title="Open the glossary">Glossary</button>
<div id="glossary-backdrop" class="glossary-backdrop"></div>
<aside id="glossary-panel" class="glossary-panel" aria-label="Glossary">
  <div class="glossary-panel-head">
    <span class="glossary-panel-title">Glossary</span>
    <button class="glossary-panel-close" type="button" onclick="closeGlossaryPanel()" aria-label="Close glossary">×</button>
  </div>
  <div class="glossary-panel-search">
    <input id="glossary-panel-search" type="search" placeholder="Filter terms…" autocomplete="off" aria-label="Filter glossary" oninput="filterGlossary(this.value)">
  </div>
  <div class="glossary-panel-body">
    <dl class="glossary-panel-list">
      {{range .GlossaryPanel}}<div class="glossary-panel-entry" data-lvl="{{.Lvl}}"><dt class="glossary-panel-term">{{.Term}}{{if .Type}} <span class="glossary-panel-type">{{.Type}}</span>{{end}}</dt><dd class="glossary-panel-def">{{.Definition}}{{if .Aliases}}<div class="glossary-panel-aliases">also: {{range $i, $a := .Aliases}}{{if $i}}, {{end}}{{$a}}{{end}}</div>{{end}}</dd></div>{{end}}
    </dl>
    <p id="glossary-panel-empty" class="glossary-panel-empty" hidden>No matching terms.</p>
  </div>
  <div class="glossary-panel-foot">
    <a class="glossary-panel-suggest" href="https://github.com/ma111e/downlink/issues/new?title=Glossary%20improvement" target="_blank" rel="noopener noreferrer">Suggest an improvement</a>
  </div>
</aside>{{end}}{{end}}

{{if .HasLearning}}<div id="tour" class="tour-overlay" role="dialog" aria-modal="true" aria-labelledby="tour-title" hidden>
  <div id="tour-spotlight" class="tour-spotlight is-centered" aria-hidden="true"></div>
  <div id="tour-card" class="tour-card">
    <div id="tour-step" class="tour-card-step"></div>
    <h2 id="tour-title" class="tour-card-title"></h2>
    <p id="tour-body" class="tour-card-body"></p>
    <div class="tour-card-foot">
      <button type="button" class="tour-btn tour-skip" id="tour-skip">Skip</button>
      <span class="tour-dots" id="tour-dots" aria-hidden="true"></span>
      <button type="button" class="tour-btn" id="tour-back">Back</button>
      <button type="button" class="tour-btn tour-btn-primary" id="tour-next">Next</button>
    </div>
  </div>
</div>{{end}}

<script type="application/json" id="dl-glossary">{{.GlossaryJSON}}</script>
<script type="application/json" id="dl-glossary-context">{{.GlossaryContextJSON}}</script>
{{if .ScriptJS}}<script type="module">{{.ScriptJS}}</script>{{end}}{{.ScriptSrc}}
</body>
</html>

{{define "v2Detail"}}<article class="v2-detail" id="detail-{{.Id}}" data-article-id="{{.Id}}" data-priority="{{priorityKey .ReadTag}}" hidden>
  <div class="v2-detail-meta">
    {{if gt .ImportanceScore 0}}<span class="v2-badge {{priorityBadgeClass .ReadTag}}">{{priorityShort .ReadTag}} · {{.ImportanceScore}}</span>{{end}}
    {{if .Category}}<span class="v2-detail-cat cat-{{.Category}}">{{.Category}}</span>{{end}}
    <span class="v2-detail-src">{{.PublishedAt}}{{if and .HasAnalysis .Analysis.ModelName}} · {{.Analysis.ModelName}}{{end}}</span>
  </div>
  <h2 class="v2-detail-title">{{.Title}}</h2>
  {{if .HasAnalysis}}
  {{if .Analysis.Rubric}}<div class="v2-rubric">
    {{range .Analysis.Rubric}}<div class="v2-rubric-cell" title="{{.Label}} {{.Value}}/4">
      <div class="v2-rubric-label">{{.Label}}</div>
      <div class="v2-rubric-bars">{{range rubricCells .Value}}<span class="v2-rc{{if .}} on{{end}}"></span>{{end}}</div>
    </div>{{end}}
  </div>{{end}}

  <div class="v2-tabs" role="tablist">
    {{if .Analysis.Tldr}}<button type="button" class="v2-tab active" onclick="v2Tab(this,'tldr-{{.Id}}')">TL;DR</button>{{end}}
    <button type="button" class="v2-tab{{if not .Analysis.Tldr}} active{{end}}" onclick="v2Tab(this,'brief-{{.Id}}')">BRIEF</button>
    {{if .Analysis.StandardSynthesis}}<button type="button" class="v2-tab" onclick="v2Tab(this,'standard-{{.Id}}')">STANDARD</button>{{end}}
    {{if .Analysis.ComprehensiveSynthesis}}<button type="button" class="v2-tab" onclick="v2Tab(this,'deep-{{.Id}}')">DEEP DIVE</button>{{end}}
    {{if .Analysis.Insights}}<button type="button" class="v2-tab" onclick="v2Tab(this,'insights-{{.Id}}')">INSIGHTS</button>{{end}}
  </div>
  <div class="v2-tabbodies">
    {{if .Analysis.Tldr}}<div id="tldr-{{.Id}}" class="v2-tabpanel active prose" data-article-id="{{.Id}}">{{.Analysis.Tldr}}{{if .Analysis.KeyPoints}}<div class="v2-kp-block">
      <div class="v2-subhead">KEY POINTS</div>
      <ul class="v2-kp v2-kp-num">{{range $i, $kp := .Analysis.KeyPoints}}<li><span class="v2-kp-num">{{printf "%02d" (add $i 1)}}</span><span class="v2-kp-text">{{$kp}}</span></li>{{end}}</ul>
    </div>{{end}}</div>{{end}}
    <div id="brief-{{.Id}}" class="v2-tabpanel{{if not .Analysis.Tldr}} active{{end}} prose" data-article-id="{{.Id}}">{{.Analysis.BriefOverview}}</div>
    {{if .Analysis.StandardSynthesis}}<div id="standard-{{.Id}}" class="v2-tabpanel prose" data-article-id="{{.Id}}">{{.Analysis.StandardSynthesis}}</div>{{end}}
    {{if .Analysis.ComprehensiveSynthesis}}<div id="deep-{{.Id}}" class="v2-tabpanel prose" data-article-id="{{.Id}}">{{.Analysis.ComprehensiveSynthesis}}</div>{{end}}
    {{if .Analysis.Insights}}<div id="insights-{{.Id}}" class="v2-tabpanel" data-article-id="{{.Id}}"><ul class="v2-kp">{{range .Analysis.Insights}}<li><span class="v2-kp-text">{{.}}</span></li>{{end}}</ul></div>{{end}}
  </div>

  {{if .Analysis.PlainWords}}<div class="v2-plain-block">
    <button type="button" class="v2-plain-label v2-subhead" onclick="v2TogglePlain(this)">IN PLAIN WORDS <span class="v2-caret">▾</span></button>
    <div class="v2-plain-body prose">{{.Analysis.PlainWords}}</div>
  </div>{{end}}

  <div class="v2-detail-actions">
    <a class="v2-btn v2-btn-primary" href="{{.Link}}" target="_blank" rel="noopener">OPEN SOURCE ↗</a>
    {{if .Analysis.Justification}}<button type="button" class="v2-btn v2-btn-ghost" onclick="v2ToggleWhy(this)">JUSTIFICATION <span class="v2-caret">▾</span></button>{{end}}
  </div>
  {{if .Analysis.Justification}}<div class="v2-why" hidden><div class="prose">{{.Analysis.Justification}}</div></div>{{end}}
  {{if .Analysis.ReferencedReports}}{{template "v2Reports" .Analysis.ReferencedReports}}{{end}}
  {{else}}<div class="v2-fail">
    <p>⚠ Analysis failed{{if .AnalysisError}} — {{.AnalysisError}}{{else}} — this article could not be scored or summarized{{end}}.</p>
    <a class="v2-btn v2-btn-primary" href="{{.Link}}" target="_blank" rel="noopener">OPEN SOURCE ↗</a>
  </div>{{end}}
</article>{{end}}

{{define "v2Reports"}}<div class="v2-reports">
  <div class="v2-subhead">REPORTS · {{len .}}</div>
  {{$hasPrimary := hasPrimary .}}{{$n := nonPrimaryCount .}}
  {{range .}}<a class="v2-report{{if and $hasPrimary (not .Primary)}} v2-report-hidden{{end}}" href="{{.URL}}" target="_blank" rel="noopener">
    <div class="v2-report-head">
      {{if .Primary}}<span class="v2-report-primary">PRIMARY</span>{{end}}
      <span class="v2-report-title">{{if .Title}}{{.Title}}{{else}}{{.URL}}{{end}}</span>
      {{if .Category}}<span class="v2-report-cat cat-{{.Category}}">{{.Category}}</span>{{end}}
    </div>
    {{if .Publisher}}<div class="v2-report-meta">{{.Publisher}}</div>{{end}}
    {{if .Context}}<div class="v2-report-context prose">{{.Context}}</div>{{end}}
  </a>{{end}}
  {{if and $hasPrimary (gt $n 0)}}<button type="button" class="v2-report-more" data-more="+{{$n}} more" onclick="v2ToggleReports(this)"><span class="v2-report-more-label">+{{$n}} more</span> <span class="v2-caret">▾</span></button>{{end}}
</div>{{end}}
