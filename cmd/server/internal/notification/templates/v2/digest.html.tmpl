        <span class="v2-help-dot" data-pos="1"></span>
        <span class="v2-help-dot" data-pos="2"></span>
        <span class="v2-help-flash" id="help-flash" aria-hidden="true"></span>
      </span>
      <div class="v2-learn-card" id="learn-card" role="menu" hidden>
