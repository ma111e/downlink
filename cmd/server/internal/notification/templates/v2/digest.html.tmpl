    <div class="v2-settings-wrap" id="nav-settings">
      <button type="button" class="v2-chip v2-chip-icon" id="settings-toggle" onclick="v2ToggleSettings()" aria-expanded="false" aria-haspopup="true" title="Settings" aria-label="Settings"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
      <div class="v2-settings-card" id="settings-card" role="menu" hidden>
        <div class="v2-learn-card-title">Theme</div>
        <select class="v2-theme" id="theme" onchange="v2ApplyTheme(this.value)" title="Select theme" aria-label="Select theme">
          {{range .Themes}}<option value="{{.Value}}">{{.Label}}</option>
          {{end}}
        </select>
        <div class="v2-learn-card-title">Interface</div>
        <button class="v2-learn-feature" id="set-anim" type="button" role="switch" aria-checked="true" onclick="v2ToggleAnim()"><span class="v2-learn-feature-label">Animations</span><span class="v2-learn-switch"><span class="v2-learn-switch-knob"></span></span></button>
        <button class="v2-learn-feature" id="set-promo" type="button" role="switch" aria-checked="false" onclick="v2TogglePromo()" title="Show or hide the commercial, sponsored and announcement categories"><span class="v2-learn-feature-label">Promotions &amp; announcements</span><span class="v2-learn-switch"><span class="v2-learn-switch-knob"></span></span></button>
        <button class="v2-learn-feature" id="set-layout" type="button" role="switch" aria-checked="true" onclick="v2ToggleLayout()" title="Switch back to the classic digest layout" hidden><span class="v2-learn-feature-label">New layout</span><span class="v2-learn-switch"><span class="v2-learn-switch-knob"></span></span></button>
        {{if .HasLearning}}<button class="v2-learn-feature" type="button" onclick="v2CloseSettings();startTour()"><span class="v2-learn-feature-label">Take the tour</span><span class="v2-settings-go" aria-hidden="true">↗</span></button>{{end}}
      </div>
    </div>
    <a class="v2-github" href="https://github.com/ma111e/downlink" target="_blank" rel="noopener noreferrer" title="View on GitHub" aria-label="View on GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
