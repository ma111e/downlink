<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
<head>
<meta charset="UTF-8">
<script>
// Pre-paint: apply the saved theme and learning flag before first paint to avoid a
// flash. Keys are shared with the default layout so a reader's choices carry across.
(function(){
  try {
    var valid = { {{range .Themes}}"{{.Value}}": 1, {{end}} };
    var t = localStorage.getItem('downlink.theme');
    if (valid[t]) document.documentElement.dataset.theme = t;
    if (localStorage.getItem('downlink.learning') === 'on') {
      var d = document.documentElement.dataset;
      d.learning = 'on';
      var lvl = localStorage.getItem('downlink.help.level');
      d.helpLevel = (lvl === '1' || lvl === '2') ? lvl : '3';
      // Per-feature sub-toggles default on unless explicitly turned off.
      d.learnPlain = localStorage.getItem('downlink.learn.plain') === 'off' ? 'off' : 'on';
      d.learnGlossary = localStorage.getItem('downlink.learn.glossary') === 'off' ? 'off' : 'on';
    }
    // Animations are on unless explicitly disabled from the settings menu.
    if (localStorage.getItem('downlink.anim') === 'off') document.documentElement.dataset.anim = 'off';
    // The commercial/sponsored/announcement categories are hidden by default (settings menu
    // toggle); they only show once the reader has explicitly turned them on.
    if (localStorage.getItem('downlink.promo') !== 'on') document.documentElement.dataset.promo = 'off';
  } catch(e){}
  function animOff(){ return document.documentElement.dataset.anim === 'off'; }
  // Arriving via a cross-document view transition: the page-slide is the entrance,
  // so flag <html> to suppress the in-page load cascade (they'd fight otherwise).
  // Cold loads / unsupported browsers keep the cascade. With animations disabled the
  // transition is skipped outright (the @view-transition opt-in can't be gated in CSS).
  addEventListener('pagereveal', function (e) {
    if (!e.viewTransition) return;
    if (animOff()) { e.viewTransition.skipTransition(); return; }
    document.documentElement.dataset.vt = 'on';
    // Clean up on rejection too: a leaked flag would make every in-page article
    // swap slide the whole root (the TOC with it) instead of just the detail pane.
    var un = function () { delete document.documentElement.dataset.vt; };
    e.viewTransition.finished.then(un, un);
  });
  addEventListener('pageswap', function (e) {
    if (e.viewTransition && animOff()) e.viewTransition.skipTransition();
  });
})();
</script>
